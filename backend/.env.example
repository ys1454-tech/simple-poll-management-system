# ==============================================================================
# Simple Poll Management System - Environment Configuration Example
# ==============================================================================
# NOTE: The credentials below are DEVELOPMENT-ONLY defaults for Docker Compose
# and GitHub Codespaces. DO NOT use these values in production environments.
# ==============================================================================

# Database Connection (MySQL 8 service 'db' in Codespaces)
DB_HOST=db
DB_PORT=3306
DB_NAME=simple_poll_db
DB_USER=poll_user
DB_PASSWORD=poll_dev_password

# Full SQLAlchemy Connection URL (using PyMySQL driver)
DATABASE_URL=mysql+pymysql://poll_user:poll_dev_password@db:3306/simple_poll_db
